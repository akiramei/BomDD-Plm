{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akiramei/BomDD/schemas/plm-diag-2.schema.json",
  "title": "BomDD PLM Diagnostics (plm-diag/2)",
  "$comment": "ECO-009 (BomDD ECO-089 / ref-v0.12 measurability): plm-diag/1 に stats.outcomes・measurement[]・findings[].outcome を加えた版。plm-diag/1 は全階層で additionalProperties: false のため、欄の追加は非互換としてメジャー版を上げた(仕様 §2.9)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "refSchema", "run", "workspace", "stats", "measurement", "findings"],
  "properties": {
    "schemaVersion": { "const": "plm-diag/2" },
    "refSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "eco"],
      "properties": {
        "gate": { "type": "string" },
        "eco": { "type": "boolean" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repos"],
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "ids", "refs", "outcomes"],
      "properties": {
        "files": { "type": "integer" },
        "ids": { "type": "integer" },
        "refs": { "type": "integer" },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["red", "measurementFailure", "notApplicable"],
          "properties": {
            "red": { "type": "integer" },
            "measurementFailure": { "type": "integer" },
            "notApplicable": { "type": "integer" }
          }
        }
      }
    },
    "measurement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause", "gate"],
        "properties": {
          "cause": { "enum": ["unreadable-input", "selector-miss", "empty-required-source", "tool-failure"] },
          "gate": { "type": "string" },
          "family": { "type": "string" },
          "rule": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "severity", "gate", "file", "message", "fixTarget"],
        "properties": {
          "rule": { "type": "string" },
          "severity": { "enum": ["error", "warn", "info"] },
          "gate": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "column": { "type": "integer" },
          "targetId": { "type": "string" },
          "message": { "type": "string" },
          "fixTarget": { "type": "string" },
          "outcome": { "enum": ["RED", "MEASUREMENT_FAILURE", "NOT_APPLICABLE"] },
          "suppressed": { "type": "boolean" },
          "suppressReason": { "type": "string" },
          "suppressRef": { "type": "string" }
        }
      }
    }
  }
}
